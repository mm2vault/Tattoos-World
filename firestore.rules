rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'mm2ultimatehub@gmail.com' ||
        request.auth.token.email == 'huseynoveleddin87@gmail.com'
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        resource.data.get('profilePublic', true) == true
      );
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        isAdmin() ||
        (
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'handle',
            'handleChangedAt',
            'bio',
            'photoURL',
            'bannerURL',
            'instagram',
            'tiktok',
            'discord',
            'website',
            'customLinks',
            'profilePublic',
            'savedTattooIds',
            'settings',
            'lastSeenAt',
            'lastLoginAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    match /tattoos/{tattooId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.creatorId == request.auth.uid &&
        (
          isAdmin() ||
          (
            request.resource.data.creatorVerified == false &&
            (
              request.resource.data.creatorRole == 'Koleksiyoner' ||
              request.resource.data.creatorRole == 'Sanatçı'
            )
          ) ||
          (
            request.resource.data.creatorVerified == true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified == true
          )
        );
      allow update: if signedIn() && (
        isAdmin() ||
        (
          resource.data.creatorId == request.auth.uid &&
          request.resource.data.creatorId == resource.data.creatorId &&
          request.resource.data.creatorVerified == resource.data.creatorVerified &&
          request.resource.data.creatorRole == resource.data.creatorRole
        )
      );
      allow delete: if signedIn() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if true;

      allow create: if signedIn() &&
        request.resource.data.creatorId == request.auth.uid;

      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']) &&
        request.auth.uid in request.resource.data.viewedBy;

      allow delete: if signedIn() && (
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.recipientUid != request.auth.uid;
      allow update: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
    }

    match /system/{docId} {
      allow read: if signedIn() && isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.senderId &&
        request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && (
        (
          request.auth.uid == resource.data.senderId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readBy',
            'reactions',
            'text',
            'editedAt',
            'replyTo'
          ])
        ) ||
        (
          request.auth.uid in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readBy',
            'reactions'
          ])
        )
      );
      allow delete: if signedIn() &&
        request.auth.uid == resource.data.senderId;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        resource.data.requesterUid == request.auth.uid ||
        resource.data.artistUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.artistUid != request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if signedIn() && (
        isAdmin() ||
        (
          resource.data.artistUid == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'declined'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
        ) ||
        (
          resource.data.requesterUid == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    match /typing/{typingId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.participants;

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.uid &&
        request.auth.uid in request.resource.data.participants;

      allow update: if signedIn() &&
        request.auth.uid == resource.data.uid &&
        request.auth.uid == request.resource.data.uid &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'participants',
          'updatedAt'
        ]);

      allow delete: if signedIn() &&
        request.auth.uid == resource.data.uid;
    }
  }
}
